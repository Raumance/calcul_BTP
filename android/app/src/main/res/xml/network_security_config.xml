<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS uniquement en production ; HTTP local autorisé en debug via manifest debug. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
